{
  "name": "digital-workforce-analytics",
  "version": "1.0.0",
  "description": "Government Digital Workforce Performance Analytics Platform",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "npm start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm install && npm install --prefix client && npm run build --prefix client",
    "seed": "node server/utils/seedData.js"
  },
  "keywords": ["government", "analytics", "performance", "workforce"],
  "author": "Government Digital Initiative",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
